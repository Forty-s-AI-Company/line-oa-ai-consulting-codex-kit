generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  workspaceId String   @default("default")
  lineUserId  String?
  displayName String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  conversations Conversation[]
  tags          UserTag[]
  escalationTasks EscalationTask[]

  @@unique([workspaceId, lineUserId])
  @@index([workspaceId])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  mode        String   @default("shared") // shared | dedicated
  ownerLineUserId String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  aiCredential AiProviderCredential?
  botSettings BotSettings?
  lineChannels LineChannelCredential[]
}

model AiProviderCredential {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  provider        String   // gemini | openai | anthropic
  model           String
  encryptedApiKey String
  enabled         Boolean  @default(true)
  monthlyBudgetLimit Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model BotSettings {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  tone        String   @default("professional")
  systemPrompt String?
  topK        Int      @default(5)
  safetyLevel String   @default("standard")
  autoReplyEnabled Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model LineChannelCredential {
  id                        String   @id @default(cuid())
  workspaceId                String
  channelId                  String?
  destination                String?  @unique
  basicId                    String?
  encryptedChannelSecret     String
  encryptedChannelAccessToken String
  enabled                    Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([channelId])
}

model UsageLog {
  id          String   @id @default(cuid())
  workspaceId String
  provider    String
  model       String
  inputTokens Int      @default(0)
  outputTokens Int     @default(0)
  estimatedCost Float  @default(0)
  lineUserId  String?
  conversationId String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
}

model Conversation {
  id            String   @id @default(cuid())
  userId        String
  startedAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())
  handoffFlag   Boolean  @default(false)
  summary       String?

  user     User      @relation(fields: [userId], references: [id])
  messages Message[]
  escalationTasks EscalationTask[]

  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // user | assistant | system
  content        String
  intent         String?
  domain         String?
  riskLevel      String?
  replyType      String?
  rawEventJson   String?
  createdAt      DateTime @default(now())

  conversation  Conversation   @relation(fields: [conversationId], references: [id])
  retrievalLogs RetrievalLog[]
  answerLogs    AnswerLog[]
  escalationTasks EscalationTask[]

  @@index([conversationId, createdAt])
}

model KnowledgeDocument {
  id              String   @id
  title           String
  domain          String
  category        String?
  sourceType      String
  sourcePath      String
  updatedAt       DateTime?
  complianceLevel String?

  chunks KnowledgeChunk[]
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  documentId String
  chunkIndex Int
  content    String
  keywords   String? // JSON string array for MVP

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, chunkIndex])
  @@unique([documentId, chunkIndex])
}

model RetrievalLog {
  id          String   @id @default(cuid())
  messageId   String
  chunkId     String?
  sourceId    String?
  sourceTitle String?
  chunkText   String
  score       Float
  metadata    String?
  createdAt   DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
}

model AnswerLog {
  id           String   @id @default(cuid())
  messageId    String
  draftText    String?
  finalText    String
  riskLevel    String
  action       String
  reasons      String? // JSON
  citations    String? // JSON
  latencyMs    Int?
  createdAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
}

model EscalationTask {
  id             String   @id @default(cuid())
  userId         String
  conversationId String?
  messageId      String?
  reason         String
  status         String   @default("open")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  message      Message?      @relation(fields: [messageId], references: [id])

  @@index([status, createdAt])
}

model UserTag {
  id        String   @id @default(cuid())
  userId    String
  tag       String
  score     Float    @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tag])
}

model PromptVersion {
  id        String   @id @default(cuid())
  name      String
  content   String
  version   Int
  createdAt DateTime @default(now())

  @@unique([name, version])
}
