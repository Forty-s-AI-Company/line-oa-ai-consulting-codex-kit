{
  "name": "@repo/api",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm -C ../../packages/db prisma generate && esbuild src/index.ts src/server.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --external:@prisma/client",
    "start": "node dist/index.js",
    "lint": "pnpm -w exec eslint .",
    "test": "pnpm -w exec vitest run apps/api/test"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@prisma/client": "^6.0.0",
    "@repo/ai": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/shared": "workspace:*",
    "dotenv": "^16.0.0",
    "fastify": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
