NODE_ENV=development

# API
APP_PORT=3000
ADMIN_API_KEY=dev-admin-key
ENABLE_MOCK_MODE=true
ENABLE_HUMAN_HANDOFF=true
DATABASE_URL="file:../../dev.db"

# Mock KB (fallback when AKB_BASE_URL is empty)
MOCK_KB_PATH=./examples/mock-kb.json

# Amway Knowledge Base (AKB) semantic search
AKB_BASE_URL=http://127.0.0.1:31000
AKB_API_TOKEN=
AKB_TIMEOUT_MS=15000

# Multi-tenant / BYOK
DEFAULT_WORKSPACE_ID=default
ENCRYPTION_KEY=change-me-to-a-long-random-secret
AI_TIMEOUT_MS=20000

# LIFF admin
LIFF_ID=2010405627-YY9AFIAV
LIFF_CHANNEL_ID=2010405627
